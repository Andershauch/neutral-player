generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("contributor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizations                  OrganizationUser[]
  invitesSent                    Invite[]               @relation("InvitesSent")
  marketingPageVersionsCreated   MarketingPageVersion[] @relation("MarketingPageVersionCreatedBy")
  marketingPageVersionsPublished MarketingPageVersion[] @relation("MarketingPageVersionPublishedBy")
  marketingAssetsUploaded        MarketingAsset[]       @relation("MarketingAssetUploadedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Offentlige kunder betaler via EAN/NemHandel-faktura frem for kort.
  billingMethod       String  @default("card") // "card" | "invoice"
  eanNumber           String?
  cvrNumber           String?
  billingContactName  String?
  billingContactEmail String?
  billingReference    String? // rekvisitions-/PO-nummer krævet af mange kommuner

  users               OrganizationUser[]
  invites             Invite[]
  subscriptions       Subscription[]
  stripeWebhookEvents StripeWebhookEvent[]
  muxWebhookEvents    MuxWebhookEvent[]
  embeds              Embed[]
  groups              Group[]
  variants            Variant[]
  auditLogs           AuditLog[]
  themes              OrganizationTheme[]
  usageMonths         UsageMonth[]
  invoiceRequests     InvoiceRequest[]
  variantSubtitles    VariantSubtitle[]
  activation          OrganizationActivation?
}

/// Aktiveringsryggraden: én kilde til hvor organisationen er i sin rejse.
/// Erstatter udledning fra AuditLog, så tilstand kan bære "sprunget over" og valgt plan.
model OrganizationActivation {
  id             String    @id @default(cuid())
  organizationId String    @unique
  intendedPlan   String? // plan valgt før betaling, båret gennem register -> setup -> checkout
  projectCreated DateTime?
  variantUploaded DateTime?
  embedCopied    DateTime?
  dismissedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Månedlig forbrugsrollup. Leveringsminutter er et estimat (afspilningsstart x varighed)
/// indtil Mux Data-afstemning er koblet på.
model UsageMonth {
  id              String   @id @default(cuid())
  organizationId  String
  yearMonth       String // "2026-08"
  playStarts      Int      @default(0)
  deliveryMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
  @@index([organizationId])
}

/// Fakturaanmodning for offentlige kunder (EAN/NemHandel).
/// Abonnementet aktiveres af intern admin når fakturaen er godkendt.
model InvoiceRequest {
  id                  String    @id @default(cuid())
  organizationId      String
  plan                String
  status              String    @default("pending") // pending | approved | rejected
  eanNumber           String
  cvrNumber           String?
  billingContactName  String?
  billingContactEmail String
  billingReference    String?
  note                String?
  requestedByUserId   String?
  handledByUserId     String?
  handledAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Invite {
  id              String    @id @default(cuid())
  organizationId  String
  invitedByUserId String?
  email           String
  role            String    @default("viewer")
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitesSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model OrganizationUser {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("viewer")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([userId])
  @@index([organizationId])
  @@index([userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String
  plan                 String    @default("free")
  status               String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model StripeWebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?
  stripeEventId  String    @unique
  type           String
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model MuxWebhookEvent {
  id             String    @id @default(cuid())
  organizationId String?
  muxEventId     String    @unique
  type           String
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Embed {
  id             String   @id @default(cuid())
  name           String
  thumbnailUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  allowedDomains String?  @default("*")

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  groups         Group[]

  @@index([organizationId])
}

model Group {
  id             String  @id @default(cuid())
  name           String
  sortOrder      Int     @default(0)
  embedId        String
  organizationId String?

  embed        Embed         @relation(fields: [embedId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  variants     Variant[]

  @@index([organizationId])
}

model Variant {
  id             String   @id @default(cuid())
  title          String?
  lang           String   @default("da")
  sortOrder      Int      @default(0)
  muxUploadId    String?
  muxPlaybackId  String?
  muxAssetId     String?
  posterFrameUrl String?
  dreamBrokerUrl String?
  // Varighed fra Mux. Grundlaget for lager- og leveringsgrænser, da Mux fakturerer pr. minut.
  durationSeconds Int?
  views          Int      @default(0)
  groupId        String
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subtitles    VariantSubtitle[]

  @@index([organizationId])
}

/// Undertekstspor pr. sprogversion. Tilgaengelighed er lovkrav for offentlige
/// websites (WCAG 2.1 AA), saa sporene foelger videoen hele vejen ud i embeddet.
model VariantSubtitle {
  id             String   @id @default(cuid())
  variantId      String
  organizationId String?
  languageCode   String
  name           String
  /// "generated" = auto-genereret hos Mux. "uploaded" = kundens egen fil.
  source         String   @default("generated")
  /// requested | ready | errored
  status         String   @default("requested")
  muxTrackId     String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variant      Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([variantId, languageCode])
  @@index([variantId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  userName       String?
  action         String
  target         String
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model OrganizationTheme {
  id             String    @id @default(cuid())
  organizationId String?
  scope          String    @default("organization")
  status         String    @default("draft")
  version        Int       @default(1)
  name           String?
  tokens         Json
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, version])
  @@index([organizationId])
  @@index([scope, status])
}

model MarketingPage {
  id                 String   @id @default(cuid())
  key                String   @unique
  title              String
  description        String?
  activeDraftId      String?  @unique
  publishedVersionId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  versions         MarketingPageVersion[]
  activeDraft      MarketingPageVersion?  @relation("MarketingPageActiveDraft", fields: [activeDraftId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  publishedVersion MarketingPageVersion?  @relation("MarketingPagePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([key])
}

model MarketingPageVersion {
  id                String    @id @default(cuid())
  marketingPageId   String
  version           Int
  status            String    @default("draft")
  schemaVersion     Int       @default(1)
  content           Json
  changeSummary     String?
  createdByUserId   String?
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  marketingPage   MarketingPage  @relation(fields: [marketingPageId], references: [id], onDelete: Cascade)
  createdByUser   User?          @relation("MarketingPageVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedByUser User?          @relation("MarketingPageVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  activeDraftFor  MarketingPage? @relation("MarketingPageActiveDraft")
  publishedFor    MarketingPage? @relation("MarketingPagePublishedVersion")

  @@unique([marketingPageId, version])
  @@index([marketingPageId, status])
  @@index([marketingPageId, publishedAt])
  @@index([createdByUserId])
  @@index([publishedByUserId])
}

model MarketingAsset {
  id               String   @id @default(cuid())
  key              String   @unique
  kind             String   @default("image")
  fileName         String
  storageKey       String
  url              String
  mimeType         String
  altText          String?
  title            String?
  width            Int?
  height           Int?
  metadata         Json?
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploadedByUser User? @relation("MarketingAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([uploadedByUserId])
}
